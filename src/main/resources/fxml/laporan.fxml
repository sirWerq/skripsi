<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.warung.haryati.controller.LaporanController" style="-fx-background-color: #f8f9fa;">
    <padding>
        <Insets top="20" left="20" right="20" bottom="20" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox>
            <Text style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: #2c3e50;" text="Laporan" />
            <Text style="-fx-font-size: 13px; -fx-fill: #7f8c8d;" text="5 Laporan Eksekutif untuk Manajemen Warung Haryati" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="card" style="-fx-padding: 10 15;">
            <VBox spacing="2">
                <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #6c757d;" text="DARI TANGGAL" />
                <DatePicker fx:id="dpStart" prefWidth="130" />
            </VBox>
            <VBox spacing="2">
                <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #6c757d;" text="SAMPAI TANGGAL" />
                <DatePicker fx:id="dpEnd" prefWidth="130" />
            </VBox>
            <Button onAction="#handleFilter" styleClass="button-primary" text="Filter">
                <HBox.margin><Insets top="14" /></HBox.margin>
            </Button>
            <Button onAction="#handleReset" styleClass="button-outline" text="Reset">
                <HBox.margin><Insets top="14" /></HBox.margin>
            </Button>
        </HBox>
    </HBox>

    <TabPane fx:id="tabPaneLaporan" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE" styleClass="card" style="-fx-padding: 10;">
        <Tab text="Laba Rugi &amp; Omset">
            <VBox spacing="15">
                <padding><Insets top="15" left="5" right="5" bottom="5" /></padding>
                
                <GridPane hgap="15" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />
                    </columnConstraints>
                    
                    <VBox spacing="5" style="-fx-background-color: #f1f3f9; -fx-background-radius: 10; -fx-padding: 12;" GridPane.columnIndex="0">
                        <Text style="-fx-fill: #6c757d; -fx-font-size: 12px; -fx-font-weight: bold;" text="TOTAL TRANSAKSI" />
                        <Text fx:id="txtTotalTransaksiLaba" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-fill: #2c3e50;" text="0" />
                    </VBox>
                    <VBox spacing="5" style="-fx-background-color: #f1f3f9; -fx-background-radius: 10; -fx-padding: 12;" GridPane.columnIndex="1">
                        <Text style="-fx-fill: #6c757d; -fx-font-size: 12px; -fx-font-weight: bold;" text="TOTAL OMSET (KOTOR)" />
                        <Text fx:id="txtTotalOmsetLaba" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-fill: #3498db;" text="Rp 0" />
                    </VBox>
                    <VBox spacing="5" style="-fx-background-color: #f1f3f9; -fx-background-radius: 10; -fx-padding: 12;" GridPane.columnIndex="2">
                        <Text style="-fx-fill: #6c757d; -fx-font-size: 12px; -fx-font-weight: bold;" text="TOTAL MODAL (HPP)" />
                        <Text fx:id="txtTotalModalLaba" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-fill: #e67e22;" text="Rp 0" />
                    </VBox>
                    <VBox spacing="5" style="-fx-background-color: #f1f3f9; -fx-background-radius: 10; -fx-padding: 12;" GridPane.columnIndex="3">
                        <Text style="-fx-fill: #6c757d; -fx-font-size: 12px; -fx-font-weight: bold;" text="TOTAL LABA BERSIH" />
                        <Text fx:id="txtTotalLabaBersih" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-fill: #2ecc71;" text="Rp 0" />
                    </VBox>
                </GridPane>

                <HBox alignment="CENTER_RIGHT">
                    <Button onAction="#handleExportLabaRugi" styleClass="button-primary" style="-fx-background-color: #e74c3c;" text="Export Laba Rugi (PDF)" />
                </HBox>

                <TableView fx:id="tableLabaRugi" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colLabaTanggal" prefWidth="120" sortable="false" text="Tanggal" />
                        <TableColumn fx:id="colLabaJmlTransaksi" prefWidth="100" sortable="false" text="Jml Transaksi" />
                        <TableColumn fx:id="colLabaOmset" prefWidth="150" sortable="false" text="Omset Penjualan" />
                        <TableColumn fx:id="colLabaModal" prefWidth="150" sortable="false" text="Modal (HPP)" />
                        <TableColumn fx:id="colLabaBersih" prefWidth="150" sortable="false" text="Laba Bersih" />
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <Tab text="Barang Terlaris">
            <VBox spacing="15">
                <padding><Insets top="15" left="5" right="5" bottom="5" /></padding>
                
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <VBox>
                        <Text style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-fill: #2c3e50;" text="Peringkat Kontribusi Produk" />
                        <Text style="-fx-font-size: 12px; -fx-fill: #7f8c8d;" text="Menampilkan produk terlaris berdasarkan kuantitas terjual dan sumbangan laba." />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#handleExportBarangTerlaris" styleClass="button-primary" style="-fx-background-color: #e74c3c;" text="Export Barang Terlaris (PDF)" />
                </HBox>

                <TableView fx:id="tableBarangTerlaris" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colRank" prefWidth="60" sortable="false" text="No" />
                        <TableColumn fx:id="colNamaBarang" prefWidth="250" sortable="false" text="Nama Barang" />
                        <TableColumn fx:id="colJmlTerjual" prefWidth="120" sortable="false" text="Terjual (Pcs)" />
                        <TableColumn fx:id="colOmsetBarang" prefWidth="150" sortable="false" text="Total Omset" />
                        <TableColumn fx:id="colLabaBarang" prefWidth="150" sortable="false" text="Total Laba" />
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <Tab text="Data Produk">
            <VBox spacing="15">
                <padding><Insets top="15" left="5" right="5" bottom="5" /></padding>
                
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <VBox spacing="5" style="-fx-background-color: #f1f3f9; -fx-background-radius: 10; -fx-padding: 12;" prefWidth="250">
                        <Text style="-fx-fill: #6c757d; -fx-font-size: 12px; -fx-font-weight: bold;" text="TOTAL PRODUK TERDAFTAR" />
                        <Text fx:id="txtTotalProduk" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-fill: #2c3e50;" text="0 Item" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#handleExportDataProduk" styleClass="button-primary" style="-fx-background-color: #e74c3c;" text="Export Data Produk (PDF)" />
                </HBox>

                <TableView fx:id="tableDataProduk" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colProdukNo" prefWidth="60" sortable="false" text="No" />
                        <TableColumn fx:id="colProdukId" prefWidth="100" sortable="false" text="ID Produk" />
                        <TableColumn fx:id="colProdukNama" prefWidth="250" sortable="false" text="Nama Barang" />
                        <TableColumn fx:id="colProdukHargaBeli" prefWidth="140" sortable="false" text="Harga Beli (Modal)" />
                        <TableColumn fx:id="colProdukHargaJual" prefWidth="140" sortable="false" text="Harga Jual" />
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <Tab text="Analisis FP-Growth">
            <VBox spacing="15">
                <padding><Insets top="15" left="5" right="5" bottom="5" /></padding>
                
                <HBox alignment="CENTER_RIGHT" spacing="15" style="-fx-background-color: #f1f3f9; -fx-background-radius: 10; -fx-padding: 12;">
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#handleExportFpGrowth" styleClass="button-primary" style="-fx-background-color: #e74c3c;" text="Export Laporan FP-Growth (PDF)" />
                </HBox>

                <TableView fx:id="tableFpGrowthReport" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colRuleAntecedents" prefWidth="140" sortable="false" text="Jika Membeli" />
                        <TableColumn fx:id="colRuleConsequents" prefWidth="140" sortable="false" text="Maka Membeli" />
                        <TableColumn fx:id="colRuleSupport" prefWidth="75" sortable="false" text="Support" />
                        <TableColumn fx:id="colRuleConfidence" prefWidth="75" sortable="false" text="Confidence" />
                        <TableColumn fx:id="colRuleLift" prefWidth="75" sortable="false" text="Lift" />
                        <TableColumn fx:id="colRuleRekomendasi" prefWidth="300" sortable="false" text="💡 Rekomendasi Strategi Bisnis" />
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <Tab text="Riwayat Transaksi">
            <VBox spacing="15">
                <padding><Insets top="15" left="5" right="5" bottom="5" /></padding>
                
                <GridPane hgap="20" vgap="0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" />
                        <ColumnConstraints percentWidth="50" />
                    </columnConstraints>
                    
                    <VBox spacing="5" style="-fx-background-color: #f1f3f9; -fx-background-radius: 10; -fx-padding: 12;" GridPane.columnIndex="0">
                        <Text style="-fx-fill: #6c757d; -fx-font-size: 12px; -fx-font-weight: bold;" text="TOTAL TRANSAKSI DALAM PERIODE" />
                        <Text fx:id="txtTotalTransaksi" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-fill: #2c3e50;" text="0" />
                    </VBox>
                    
                    <VBox spacing="5" style="-fx-background-color: #f1f3f9; -fx-background-radius: 10; -fx-padding: 12;" GridPane.columnIndex="1">
                        <Text style="-fx-fill: #6c757d; -fx-font-size: 12px; -fx-font-weight: bold;" text="TOTAL PENDAPATAN DALAM PERIODE" />
                        <Text fx:id="txtTotalPendapatan" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-fill: #27ae60;" text="Rp 0" />
                    </VBox>
                </GridPane>

                <HBox alignment="CENTER_RIGHT">
                    <Button onAction="#handleExport" styleClass="button-primary" style="-fx-background-color: #e74c3c;" text="Export Detail Transaksi (PDF)" />
                </HBox>

                <TableView fx:id="tableLaporan" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colTanggal" prefWidth="130" sortable="false" text="Tanggal" />
                        <TableColumn fx:id="colId" prefWidth="110" sortable="false" text="ID Transaksi" />
                        <TableColumn fx:id="colItems" prefWidth="300" sortable="false" text="Items" />
                        <TableColumn fx:id="colTotal" prefWidth="130" sortable="false" text="Total" />
                    </columns>
                </TableView>
            </VBox>
        </Tab>

    </TabPane>
</VBox>
