<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.warung.haryati.controller.LoginController" stylesheets="@../css/style.css" styleClass="root">
    
    <VBox alignment="CENTER" spacing="15.0" styleClass="card" maxWidth="400">
        <ImageView fitWidth="100.0" fitHeight="100.0" preserveRatio="true">
            <image>
                <Image url="@../images/logo.png"/>
            </image>
        </ImageView>
        <VBox alignment="CENTER" spacing="5.0">
            <Text style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-fill: #2c3e50;" text="Warung Haryati"/>
            <Text style="-fx-font-size: 14px; -fx-fill: #7f8c8d;" text="Sistem Analisis Penjualan FP-Growth"/>
        </VBox>
        
        <Region prefHeight="15.0" />

        <VBox spacing="8.0" alignment="CENTER_LEFT">
            <Label text="Username" style="-fx-font-weight: bold;"/>
            <TextField fx:id="usernameField" promptText="Username" />
        </VBox>

        <VBox spacing="8.0" alignment="CENTER_LEFT">
            <Label text="Password" style="-fx-font-weight: bold;"/>
            <HBox fx:id="passwordContainer" spacing="0" alignment="CENTER_LEFT" styleClass="password-container">
                <StackPane HBox.hgrow="ALWAYS">
                    <PasswordField fx:id="passwordField" promptText="Password" styleClass="password-field-inner"/>
                    <TextField fx:id="passwordTextField" promptText="Password" visible="false" styleClass="password-field-inner"/>
                </StackPane>
                <Button fx:id="togglePasswordBtn" onAction="#togglePassword" styleClass="eye-button" focusTraversable="false">
                    <graphic>
                        <FontIcon fx:id="eyeIcon" iconLiteral="fas-eye" iconSize="16" iconColor="#7f8c8d"/>
                    </graphic>
                </Button>
            </HBox>
        </VBox>

        <Region prefHeight="10.0" />

        <Button onAction="#handleLogin" text="MASUK" styleClass="button-primary" maxWidth="Infinity"/>
        
        <Label fx:id="errorLabel" style="-fx-text-fill: #e74c3c; -fx-font-size: 12px;" />
    </VBox>
</VBox>
