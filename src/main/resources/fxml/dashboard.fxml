<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>

<HBox prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.warung.haryati.controller.DashboardController" stylesheets="@../css/style.css" styleClass="root">
    <VBox spacing="0" styleClass="sidebar" prefWidth="240">
        <padding>
            <Insets top="30" />
        </padding>
        <VBox alignment="CENTER" spacing="10">
            <padding>
                <Insets bottom="30" left="20" right="20" />
            </padding>
            <ImageView fitWidth="100.0" fitHeight="100.0" preserveRatio="true">
                <image>
                    <Image url="@../images/logo.png"/>
                </image>
            </ImageView>
            <Text style="-fx-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="Warung Haryati" />
        </VBox>

        <Button fx:id="btnDashboard" onAction="#showDashboard" maxWidth="Infinity" styleClass="sidebar-button, sidebar-button-active" text="Dashboard" />
        <Button fx:id="btnProduk" onAction="#showProduk" maxWidth="Infinity" styleClass="sidebar-button" text="Kelola Data Produk" />
        <Button fx:id="btnTransaksi" onAction="#showTransaksi" maxWidth="Infinity" styleClass="sidebar-button" text="Kelola Data Transaksi" />
        <Button fx:id="btnDetailTransaksi" onAction="#showDetailTransaksi" maxWidth="Infinity" styleClass="sidebar-button" text="Kelola Detail Transaksi" />
        <Button fx:id="btnAnalisis" onAction="#showAnalisis" maxWidth="Infinity" styleClass="sidebar-button" text="Analisis FP-Growth" />
        <Button fx:id="btnLaporan" onAction="#showLaporan" maxWidth="Infinity" styleClass="sidebar-button" text="Laporan" />
        
        <Region VBox.vgrow="ALWAYS" />
        
        <Button onAction="#handleLogout" maxWidth="Infinity" styleClass="sidebar-button" style="-fx-text-fill: #e74c3c;" text="Logout" />
    </VBox>
    
    <StackPane fx:id="contentArea" HBox.hgrow="ALWAYS" style="-fx-background-color: #f8f9fa;">
        <padding>
            <Insets top="30" left="40" right="40" bottom="30" />
        </padding>
        
        <VBox fx:id="dashboardView" spacing="30">
            <HBox alignment="CENTER_LEFT">
                <Text style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-fill: #2c3e50;" text="Dashboard" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#handleImport" styleClass="button-primary" style="-fx-background-color: #2ecc71;" text="Import Dataset" />
            </HBox>
            
            <GridPane hgap="25" vgap="0">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" />
                    <ColumnConstraints percentWidth="50" />
                </columnConstraints>
                
                <VBox spacing="10" styleClass="card" GridPane.columnIndex="0">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <VBox>
                            <Text style="-fx-fill: #95a5a6; -fx-font-size: 14px;" text="Total Transaksi" />
                            <Text fx:id="txtTotalTransaksi" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="0" />
                        </VBox>
                    </HBox>
                </VBox>
                
                <VBox spacing="10" styleClass="card" GridPane.columnIndex="1">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <VBox>
                            <Text style="-fx-fill: #95a5a6; -fx-font-size: 14px;" text="Total Produk" />
                            <Text fx:id="txtTotalProduk" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="0" />
                        </VBox>
                    </HBox>
                </VBox>
            </GridPane>
            
            <VBox VBox.vgrow="ALWAYS" styleClass="card" spacing="15">
                <Text style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Tren Penjualan Per Bulan" />
                <LineChart fx:id="salesChart" legendSide="BOTTOM" createSymbols="false" style="-fx-background-color: transparent;">
                    <xAxis><CategoryAxis side="BOTTOM" label="Tanggal" /></xAxis>
                    <yAxis><NumberAxis side="LEFT" label="Pendapatan (Rp)" /></yAxis>
                </LineChart>
            </VBox>
        </VBox>
    </StackPane>
</HBox>
