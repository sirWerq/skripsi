<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.warung.haryati.controller.TransaksiFormController" prefWidth="500">
    <padding>
        <Insets top="20" left="20" right="20" bottom="20" />
    </padding>

    <HBox spacing="15" alignment="CENTER_LEFT">
        <Label text="Tanggal:" />
        <DatePicker fx:id="tanggalPicker" />
    </HBox>

    <Separator />

    <VBox spacing="10">
        <HBox spacing="10" alignment="BOTTOM_LEFT">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Pilih Produk" />
                <ComboBox fx:id="produkCombo" maxWidth="Infinity" />
            </VBox>
            <VBox spacing="5" prefWidth="80">
                <Label text="Qty" />
                <TextField fx:id="qtyField" />
            </VBox>
            <Button text="Tambah Item" onAction="#handleTambahItem" styleClass="button-primary" />
        </HBox>

        <TableView fx:id="tableItems" prefHeight="200">
            <columns>
                <TableColumn fx:id="colProduk" prefWidth="200" text="Produk" />
                <TableColumn fx:id="colQty" prefWidth="70" text="Qty" />
                <TableColumn fx:id="colSubtotal" prefWidth="120" text="Subtotal" />
            </columns>
        </TableView>
    </VBox>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Label text="Total: " style="-fx-font-weight: bold;" />
        <Label fx:id="totalLabel" text="Rp 0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #007bff;" />
    </HBox>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Batal" onAction="#handleBatal" />
        <Button text="Simpan Transaksi" onAction="#handleSimpan" styleClass="button-primary" />
    </HBox>
</VBox>
