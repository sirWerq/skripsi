<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.warung.haryati.controller.TransaksiFormController" prefWidth="350">
    <padding>
        <Insets top="20" left="20" right="20" bottom="20" />
    </padding>

    <Label text="Form Data Transaksi" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <HBox spacing="15" alignment="CENTER_LEFT">
        <Label text="ID Transaksi:" prefWidth="80" />
        <TextField fx:id="idField" HBox.hgrow="ALWAYS" promptText="Masukkan ID Transaksi (Misal: TRX-001)" />
    </HBox>

    <HBox spacing="15" alignment="CENTER_LEFT">
        <Label text="Tanggal:" prefWidth="80" />
        <DatePicker fx:id="tanggalPicker" />
    </HBox>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <padding>
            <Insets top="10" />
        </padding>
        <Button text="Batal" onAction="#handleBatal" />
        <Button text="Simpan" onAction="#handleSimpan" styleClass="button-primary" />
    </HBox>
</VBox>
