<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.warung.haryati.controller.TransaksiDetailController" prefWidth="600">
    <padding>
        <Insets top="20" left="20" right="20" bottom="20" />
    </padding>

    <HBox spacing="40">
        <VBox spacing="5">
            <Text style="-fx-fill: #7f8c8d;" text="ID Transaksi" />
            <Text fx:id="txtId" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="#0" />
        </VBox>
        <VBox spacing="5">
            <Text style="-fx-fill: #7f8c8d;" text="Tanggal" />
            <Text fx:id="txtTanggal" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="-" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <VBox spacing="5" alignment="CENTER_RIGHT">
            <Text style="-fx-fill: #7f8c8d;" text="Total Bayar" />
            <Text fx:id="txtTotal" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #007bff;" text="Rp 0" />
        </VBox>
    </HBox>

    <TableView fx:id="tableItems" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colProduk" prefWidth="250" text="Nama Barang" />
            <TableColumn fx:id="colHarga" prefWidth="120" text="Harga Satuan" />
            <TableColumn fx:id="colQty" prefWidth="70" text="Qty" />
            <TableColumn fx:id="colSubtotal" prefWidth="120" text="Subtotal" />
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT">
        <Button text="Tutup" onAction="#handleTutup" styleClass="button-primary" />
    </HBox>
</VBox>
